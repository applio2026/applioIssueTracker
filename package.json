{
  "name": "tracking-system",
  "version": "0.1.0",
  "private": true,
  "description": "University Tracking System — Jira-style ticketing (React + Node + PostgreSQL)",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace api run dev",
    "dev:web": "npm --workspace web run dev",
    "db:migrate": "npm --workspace api run db:migrate",
    "db:seed": "npm --workspace api run db:seed",
    "db:studio": "npm --workspace api run db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
