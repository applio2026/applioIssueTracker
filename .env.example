# docker-compose secrets — copy to ".env" (next to docker-compose.yml) and fill in.
# `docker compose up` reads this automatically. Never commit the real .env.
# Generate strong values with: openssl rand -base64 32   (or node crypto.randomBytes)

# PostgreSQL password for the tracking DB user
POSTGRES_PASSWORD=

# JWT signing secrets — 32+ random chars each, and DIFFERENT from one another.
# The API refuses to start in production if these are weak/placeholders.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shared secret with the main app (x-api-key for provisioning + SSO).
# Must match the main app's INTEGRATION_API_KEY exactly.
INTEGRATION_API_KEY=

# Initial Super Admin password (seeding refuses the old 'Admin@123' in production)
SEED_SUPERADMIN_EMAIL=superadmin@university.edu
SEED_SUPERADMIN_PASSWORD=

# SMTP (optional — leave blank to log mail to the console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
