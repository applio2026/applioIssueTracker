# PostgreSQL connection string
# Local install example (adjust user/password/port to your setup):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracking?schema=public"
# Docker compose example (db is exposed on host port 5436):
# DATABASE_URL="postgresql://tracking:tracking@localhost:5436/tracking?schema=public"

# Server
# Dev uses 4150 (4100 is taken by applio-billing-console locally).
# Keep in sync with the proxy target in web/vite.config.js.
PORT=4150
NODE_ENV=development
CLIENT_URL="http://localhost:5177"

# Auth — CHANGE THESE in production
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Integration API key — shared secret a partner app sends as the `x-api-key`
# header to provision ticket-raising logins (POST /api/integration/users).
# Leave empty to disable the integration endpoint. Generate a long random value.
INTEGRATION_API_KEY=""

# Public marketing-site origins (comma-separated) allowed by CORS to post to
# the unauthenticated /api/public/* form endpoints (e.g. demo requests from
# the Applio Stack landing page, which runs on 5163 in dev).
PUBLIC_CORS_ORIGINS="http://localhost:5163"

# Email (optional). If SMTP_HOST is empty, emails are logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Tracking System <no-reply@university.edu>"

# Seed Super Admin
SEED_SUPERADMIN_EMAIL="superadmin@university.edu"
SEED_SUPERADMIN_PASSWORD="Admin@123"
SEED_SUPERADMIN_NAME="Super Admin"
