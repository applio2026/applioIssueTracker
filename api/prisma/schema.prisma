generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DEVELOPER
  ADMIN
  SUPER_ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  ON_HOLD
  IN_REVIEW
  RESOLVED
  CLOSED
  REJECTED
  REOPENED
}

enum SubTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  COMMENTED
  REOPENED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  department   String?
  company      String?  // Required for CUSTOMER accounts; drives a ticket's label.
  isActive     Boolean  @default(true)

  // Per-user permission grants (layered on top of role defaults — see
  // features/users/permissions.js). Departments scope which categories a
  // staff member can see/handle.
  canRaiseTickets  Boolean @default(true)
  canManageTickets Boolean @default(false)
  canViewDashboard Boolean @default(false)
  canManageUsers   Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestedTickets Ticket[]       @relation("Requester")
  assignedTickets  Ticket[]       @relation("Assignee")
  comments         Comment[]
  activities       Activity[]
  notifications    Notification[]
  subTasksAssigned SubTask[]      @relation("SubTaskAssignee")
  subTasksCreated  SubTask[]      @relation("SubTaskCreator")
  timeLogs         TimeLog[]
  ssoTokens        SsoToken[]
  watching         TicketWatcher[]
  departments      UserDepartment[]
}

// Which categories (departments) a staff user is scoped to.
model UserDepartment {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@unique([userId, categoryId])
}

// One-time SSO sign-in tokens issued via the integration API.
// Only a SHA-256 hash of the token is stored; rows are deleted on use.
model SsoToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id              String   @id @default(cuid())
  name            String   @unique
  defaultTeam     String?
  defaultSlaHours Int      @default(48)
  createdAt       DateTime @default(now())

  tickets Ticket[]
  members UserDepartment[]
}

model Ticket {
  id          String       @id @default(cuid())
  key         String       @unique // e.g. UNIV-101
  title       String
  description String
  label       String       @default("local") // Customer's company name, else "local".
  status      TicketStatus @default(NEW)
  priority    Priority     @default(MEDIUM)

  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?

  requester   User    @relation("Requester", fields: [requesterId], references: [id])
  requesterId String

  assignee    User?   @relation("Assignee", fields: [assigneeId], references: [id])
  assigneeId  String?

  slaDueAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  comments    Comment[]
  attachments Attachment[]
  activities  Activity[]
  subTasks    SubTask[]
  timeLogs    TimeLog[]
  watchers    TicketWatcher[]
  linksFrom   TicketLink[]    @relation("LinkFrom")
  linksTo     TicketLink[]    @relation("LinkTo")

  @@index([status])
  @@index([assigneeId])
  @@index([requesterId])
}

// Users following a ticket — they get notified about status changes/comments.
model TicketWatcher {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
}

// "Relates to" links between two tickets.
model TicketLink {
  id          String   @id @default(cuid())
  from        Ticket   @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  fromId      String
  to          Ticket   @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)
  toId        String
  createdById String
  createdAt   DateTime @default(now())

  @@unique([fromId, toId])
}

model SubTask {
  id          String        @id @default(cuid())
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  title       String
  status      SubTaskStatus @default(TODO)
  assignee    User?         @relation("SubTaskAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  createdBy   User          @relation("SubTaskCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ticketId])
  @@index([assigneeId])
}

// Work time logged against a ticket, in minutes.
model TimeLog {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  minutes   Int
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Comment {
  id         String   @id @default(cuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  attachments Attachment[]
}

model Attachment {
  id         String   @id @default(cuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId  String?
  fileName   String
  filePath   String
  mimeType   String?
  size       Int?
  uploadedById String
  createdAt  DateTime @default(now())
}

model Activity {
  id        String       @id @default(cuid())
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  actor     User         @relation(fields: [actorId], references: [id])
  actorId   String
  type      ActivityType
  fromValue String?
  toValue   String?
  createdAt DateTime     @default(now())

  @@index([ticketId])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  ticketId  String?
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// Auto-increment counter for human-friendly ticket keys (UNIV-101, ...)
model Counter {
  id    String @id
  value Int    @default(0)
}
